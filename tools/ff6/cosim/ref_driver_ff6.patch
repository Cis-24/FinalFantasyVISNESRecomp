+static uint8_t *load_pc_set(const char *env) {
+    const char *path = getenv(env);
+    if (!path || !path[0]) return NULL;
+    FILE *f = fopen(path, "r");
+    if (!f) { fprintf(stderr, "ref: cannot read %s '%s'\n", env, path); return NULL; }
+    uint8_t *set = calloc(1u << 21, 1);
+    unsigned pc, n = 0;
+    while (set && fscanf(f, "%x", &pc) == 1) {
+        pc &= 0xFFFFFFu;
+        set[pc >> 3] |= (uint8_t)(1u << (pc & 7));
+        n++;
+    }
+    fclose(f);
+    fprintf(stderr, "ref: %u PCs from %s (%s)\n", n, path, env);
+    return set;
+}
+
+static bool pc_in_set(const uint8_t *set, uint32_t pc) {
+    return set && (set[(pc & 0xFFFFFFu) >> 3] & (1u << (pc & 7)));
