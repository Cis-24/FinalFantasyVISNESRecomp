+/* FF6 variant: advance guest time (beam walk + accurate APU) by `master` clocks. */
+static void ref_advance(uint64_t master) {
+    Snes *snes = g_snes;
+    g_ref_master_cycles += master;
+    for (uint64_t i = 0; i < master; i += 2) handle_pos_stuff(snes);
+    /* accurate APU: advance the real SPC at the true rate */
+    snes->apuCatchupCycles += (double)master * kApuCyclesPerMaster;
+    snes_catchupApu(snes);
+}
+
+/* FF6 variant: a $420B DMA's guest time (snes.c charges it before the transfer).
+ * Without this hook snes.c walks its own beam behind the driver's back. */
+static void ref_dma_charge(Snes *snes, uint64_t clocks) {
+    (void)snes;
+    s_dma_master += clocks;
+    ref_advance(clocks);
+}
