+static int      s_in_file = -1;
+static FILE    *s_in_f;
+static bool     s_in_have_next;
+static uint64_t s_in_next_frame;
+static unsigned s_in_next_mask;
+static uint16_t s_in_mask;
+
+static void input_file_advance(void) {
+    unsigned long long frame = 0;
+    unsigned mask = 0;
+    s_in_have_next = fscanf(s_in_f, "%llu %x", &frame, &mask) == 2;
+    s_in_next_frame = frame;
+    s_in_next_mask = mask;
+}
+
+static bool input_file_mask(uint16_t *input) {
+    if (s_in_file < 0) {
+        const char *path = getenv("FF6_REF_INPUT_FILE");
+        s_in_file = path && path[0];
+        if (s_in_file) {
+            s_in_f = fopen(path, "r");
+            if (!s_in_f) {
+                fprintf(stderr, "ref: cannot read FF6_REF_INPUT_FILE '%s'\n", path);
+                exit(1);
+            }
+            input_file_advance();
+        }
+    }
+    if (!s_in_file) return false;
+    while (s_in_have_next && s_in_next_frame <= s_frames) {
+        s_in_mask = (uint16_t)s_in_next_mask;
+        input_file_advance();
+    }
+    *input = s_in_mask;
+    return true;
+}
