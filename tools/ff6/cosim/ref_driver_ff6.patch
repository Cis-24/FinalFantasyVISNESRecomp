+/* FF6 variant: a $420B DMA's guest time (snes.c charges it before the transfer).
+ * Without this hook snes.c walks its own beam behind the driver's back. */
+static void ref_dma_charge(Snes *snes, uint64_t clocks) {
+    (void)snes;
+    s_dma_master += clocks;
+    ref_advance(clocks);
+}
