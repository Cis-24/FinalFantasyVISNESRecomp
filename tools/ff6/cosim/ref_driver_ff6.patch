+/* FF6 variant: the RDNMI poll window of the beam frame driver (snesrecomp patch 0003,
+ * beam_frame_driver.c insn_reads_rdnmi/insn_closes_rdnmi_poll). RDNMI rises at V=225 a
+ * moment before the CPU takes the NMI; FF6 polls it after a sound command (EventCmd_f0/ef/f1:
+ * `lda $4210 / bpl`) and FieldNMI acknowledges RDNMI on entry, so the poll only ends if it
+ * reads the flag in that window. Cut at the opcode boundary after V=225, this driver took
+ * the NMI first and the poll spun for good. Like A, when the frame starts with the flag
+ * latched and the NMI pending, the poll's closing `bpl` and then its read run before it. */
+static bool insn_reads_rdnmi(uint32_t pc) {
+    uint8_t op = snes_read(g_snes, pc);
+    if (op != 0xADu && op != 0x2Cu)
+        return false;
+    return snes_read(g_snes, (pc & 0xFF0000u) | ((pc + 1u) & 0xFFFFu)) == 0x10u &&
+           snes_read(g_snes, (pc & 0xFF0000u) | ((pc + 2u) & 0xFFFFu)) == 0x42u;
+}
+
+static bool insn_closes_rdnmi_poll(uint32_t pc) {
+    if (snes_read(g_snes, pc) != 0x10u)
+        return false;
+    const int8_t rel = (int8_t)snes_read(g_snes, (pc & 0xFF0000u) | ((pc + 1u) & 0xFFFFu));
+    return insn_reads_rdnmi((pc & 0xFF0000u) | ((pc + 2u + (uint32_t)(int32_t)rel) & 0xFFFFu));
+}
