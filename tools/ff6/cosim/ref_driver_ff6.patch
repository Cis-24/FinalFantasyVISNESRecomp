+/* FF6 variant: advance the SPC alone by `master` clocks. */
+static void ref_apu_advance(uint64_t master) {
+    Snes *snes = g_snes;
+    if (s_apu_like_a < 0) s_apu_like_a = getenv("FF6_REF_APU_LIKE_A") != NULL;
+    if (s_apu_like_a && !s_spc_started) return;   /* SPC stands still until the first write */
+    /* accurate APU: advance the real SPC at the true rate */
+    snes->apuCatchupCycles += (double)master * kApuCyclesPerMaster;
+    snes_catchupApu(snes);
+}
+
+/* FF6 variant: advance guest time (beam walk + accurate APU) by `master` clocks. */
+static void ref_advance(uint64_t master) {
+    Snes *snes = g_snes;
+    g_ref_master_cycles += master;
+    for (uint64_t i = 0; i < master; i += 2) handle_pos_stuff(snes);
+    ref_apu_advance(master);
+}
+
+/* FF6 variant: APU port accesses at their bus cycle. snes9x runs the SPC up to the CPU clock
+ * at the start of a port access, after the opcode's earlier fetches, transfers and internal
+ * cycles (apu.cpp S9xAPUReadPort/S9xAPUWritePort, getset.h). This driver advanced the SPC
+ * only after the whole opcode, so a port read saw the SPC as of the opcode start and a port
+ * write (latched at once, RtlApuWrite) reached it there. Now, before an access to
+ * $2140-$217F the SPC catches up to the opcode start plus the bus transfers before this one
+ * (s_apu_given); the rest of the opcode follows after it. Internal cycles that precede a
+ * transfer inside an opcode (indexed modes) are not placed; FF6 reaches the ports with
+ * absolute addressing only (sound_main.asm). FF6_REF_PORT_AT_OPCODE=1 restores the old
+ * timing (diagnostic). */
+static uint64_t s_apu_given;       /* master clocks of the current opcode the SPC already has */
+static int      s_port_at_opcode = -1;
+
+static void ref_port_sync(uint32_t adr, unsigned speed) {
+    uint8_t bank = (uint8_t)(adr >> 16);
+    if (!(bank < 0x40 || (bank >= 0x80 && bank < 0xc0)) || (adr & 0xFFC0u) != 0x2140u)
+        return;
+    if (s_port_at_opcode < 0) s_port_at_opcode = getenv("FF6_REF_PORT_AT_OPCODE") != NULL;
+    if (s_port_at_opcode) return;
+    uint64_t at = s_bus_master - speed;            /* start of this transfer */
+    if (at > s_apu_given) {
+        ref_apu_advance(at - s_apu_given);
+        s_apu_given = at;
     }
 }
 
+/* FF6 variant, diagnostic: FF6_REF_PORT_LOG=<file> with FF6_REF_PORT_LOG_FRAMES=lo-hi writes
+ * every CPU access to $2140-$2143 in frames lo..hi (frame = cuts so far) as
+ * "f=frame m=master spc=portClock W|R p=port v=value", m = the start of the transfer, the
+ * same line as src/game_rtl.c (FF6_COSIM_PORT_LOG). */
+static void ref_port_log(char kind, uint32_t adr, unsigned speed, uint8_t v) {
+    static int init;
+    static FILE *f;
+    static unsigned long long lo, hi;
+    uint8_t bank = (uint8_t)(adr >> 16);
+    if (!(bank < 0x40 || (bank >= 0x80 && bank < 0xc0)) || (adr & 0xFFC0u) != 0x2140u)
+        return;
+    if (!init) {
+        const char *path = getenv("FF6_REF_PORT_LOG");
+        const char *range = getenv("FF6_REF_PORT_LOG_FRAMES");
+        init = 1;
+        if (path && path[0] && range && sscanf(range, "%llu-%llu", &lo, &hi) == 2)
+            f = fopen(path, "w");
+    }
+    if (!f || s_frames < lo || s_frames > hi) return;
+    fprintf(f, "f=%llu m=%llu spc=%llu %c p=%u v=%02x\n", (unsigned long long)s_frames,
+            (unsigned long long)(g_ref_master_cycles + s_bus_master - speed),
+            (unsigned long long)g_snes->apu->portClock, kind, (unsigned)(adr & 3), v);
+    fflush(f);
+}
