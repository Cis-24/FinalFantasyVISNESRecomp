# Generated recompiler output, derived from a copyrighted ROM. Never commit.
/src/gen/
/recomp/funcs.h

# The ROM itself, in every form. Players supply their own.
*.sfc
*.smc
*.srm

# Build trees and packaged output
/build/
/build-*/
/dist/
/saves/

# Local probe output that names paths on one machine
/rom_probe.json

# Launcher/runtime state written beside the executable (and in the repo root
# when the game is run from there): the cached ROM path, keybinds, settings.
# All of it is one machine's, none of it is the project's.
/rom.cfg
/keybinds.ini
/config.ini
/input.ini
# Ebenso: Absturz-/Laufbericht, Mod-Auswahl (MOD_AUTHORING.md: "do not distribute"),
# snesref-Audio, wenn aus der Repo-Wurzel gestartet.
/last_run_report.json
/mods/preloaded/state.toml
/snesref_audio.wav

.DS_Store

# FF6-Recomp: Scratch, Authority, Laufdaten (ROM-abgeleitet oder maschinenspezifisch)
/work/
*.authority.json
/validation/out/
*.jsonl
*.wram.bin
*.vram.bin
*.sram.bin
*.fb.*
*.bgrx
/cfg-overlay*/

# Lokale Coverage-Captures und die daraus erzeugte Recipe (regen.sh)
/recomp/coverage/
/recomp/generate.toml
__pycache__/
