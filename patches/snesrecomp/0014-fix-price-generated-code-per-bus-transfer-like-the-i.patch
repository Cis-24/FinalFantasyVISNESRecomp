+    if mn not in _STORE_MNEMS:
+        return False
+    mode = getattr(insn, 'mode', None)
+    operand = getattr(insn, 'operand', 0) or 0
+    if mode == _MODE_ABS:
+        base = operand & 0xFFFF
+    elif mode == _MODE_LONG:
