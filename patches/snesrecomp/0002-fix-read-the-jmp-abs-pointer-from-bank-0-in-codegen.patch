From 0e747f99fc55c4027a5daf10b306beac8d4922ac Mon Sep 17 00:00:00 2001
From: Neivin Detlefsen <neivin.detlefsen@gmx.de>
Date: Fri, 30 Oct 2026 00:01:52 +0100
Subject: [PATCH 02/10] fix: read the jmp (abs) pointer from bank 0 in codegen

Opcode $6C fetches its 16-bit pointer from 00:abs; only the jump target
lands in PB. _emit_indirect_dispatch read the pointer from PB:abs in two
branches (local computed goto and the non-indexed value-pointer
dispatch), contrary to the docstring of _live_indirect_target_expr and
to the interpreter (interp816.c, case 0x6c). Games running in bank 0
cannot tell the difference, so the existing tests pinned the PB read.

In HiROM bank C0 it breaks FF6's event engine as soon as it runs
natively: `jmp ($002a)` (C0:9B59) loaded the ROM word C0:002A = $AB48
instead of the handler pointer in WRAM $002A, missed every case and
tail-dispatched the interpreter to C0:AB48, the middle of an
instruction.

Read the pointer from bank 0 in both branches and update the two test
expectations. New tests emit both dispatch forms in HiROM bank C0 with
the FF6 decoy word at C0:002A. JML [abs], JMP/JSR (abs,X) and
_live_indirect_target_expr were already correct.
---
 recompiler/v2/codegen.py                      |   6 +-
 .../test_indirect_dispatch_parallel_tables.py |   2 +-
 tests/v2/test_jmp_abs_pointer_bank.py         | 109 ++++++++++++++++++
 tests/v2/test_local_stride_runway_dispatch.py |   2 +-
 4 files changed, 115 insertions(+), 4 deletions(-)
 create mode 100644 tests/v2/test_jmp_abs_pointer_bank.py

diff --git a/recompiler/v2/codegen.py b/recompiler/v2/codegen.py
index 163ba5a..6690d71 100644
--- a/recompiler/v2/codegen.py
+++ b/recompiler/v2/codegen.py
@@ -1533,8 +1533,9 @@ def _emit_indirect_dispatch(insn) -> List[str]:
                 f"(uint16)(cpu->D + 0x{ptr:04x})) + 1u);"
                 "  /* PEI(dp); RTS consumes target-1 as an internal goto */")
         else:
+            # JMP (abs): the pointer lives in bank 0, the target bank is PB.
             lines.append(
-                f"  uint16 _target = cpu_read16(cpu, cpu->PB, (uint16)0x{ptr:04x});"
+                f"  uint16 _target = cpu_read16(cpu, 0x00, (uint16)0x{ptr:04x});"
                 "  /* absolute indirect dispatch: switch on the loaded pointer */")
         lines.append("  switch (_target) {")
         seen_cases = set()
@@ -1631,8 +1632,9 @@ def _emit_indirect_dispatch(insn) -> List[str]:
                 "  uint16 _target = cpu_read16(cpu, cpu->PB, _ptr);"
                 "  /* switch on the loaded pointer */")
         else:
+            # JMP (abs): the pointer lives in bank 0, the target bank is PB.
             lines.append(
-                f"  uint16 _target = cpu_read16(cpu, cpu->PB, (uint16)0x{ptr:04x});"
+                f"  uint16 _target = cpu_read16(cpu, 0x00, (uint16)0x{ptr:04x});"
                 "  /* absolute indirect dispatch: switch on the loaded pointer */"
             )
         if is_rts_stack_dispatch:
