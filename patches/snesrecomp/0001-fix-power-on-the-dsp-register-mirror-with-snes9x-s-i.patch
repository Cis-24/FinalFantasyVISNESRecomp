From 0df8f701976b046f239f2f8e28a61e676fcad12a Mon Sep 17 00:00:00 2001
From: Neivin Detlefsen <neivin.detlefsen@gmx.de>
Date: Thu, 29 Oct 2026 22:31:25 +0100
Subject: [PATCH 01/10] fix: power on the dsp register mirror with snes9x's
 initial values

The S-DSP register file reads back undefined values after power-on.
dsp_reset zeroed it, so a driver that reads a register before writing
it saw 0 where snes9x sees its initial_regs table. FF6's echo init
waits (old EDL & $0F) 16 ms timer ticks; EDL = 0 made that 256 ticks
and booted the game 212 frames later than snes9x.

Load the SPC-visible mirror from snes9x 1.63's initial_regs
(libretro/snes9x fae2fea08f74, apu/bapu/dsp/SPC_DSP.cpp), which
SPC_DSP::load copies into external_regs, the file SPC_DSP::read
returns. Synthesis state is unchanged: snes9x synthesizes from a
separate internal register file that powers on cleared with
FLG = $E0, which the derived fields already model (no keyOn latch
for KON, echoDelay stays 1 although EDL reads $4E). ENDX starts at 0
because snes9x replaces the table's $FF with its internal ENDX on the
first sample. Its internal V4/V5 PITCHL = 1 is not mirrored, since
this core keeps pitchCounter across key-on where snes9x resets it.
---
 runner/src/snes/dsp.c | 29 +++++++++++++++++++++++++++--
 1 file changed, 27 insertions(+), 2 deletions(-)

diff --git a/runner/src/snes/dsp.c b/runner/src/snes/dsp.c
index 62f11be..c33b90d 100644
--- a/runner/src/snes/dsp.c
+++ b/runner/src/snes/dsp.c
@@ -57,6 +57,23 @@ const uint16_t gaussValues[512] = {
   0x513, 0x514, 0x514, 0x515, 0x516, 0x516, 0x517, 0x517, 0x517, 0x518, 0x518, 0x518, 0x518, 0x518, 0x519, 0x519
 };
 
+/* Power-on contents of the SPC-visible register file ($F3 reads), verbatim
+ * from snes9x 1.63 (libretro/snes9x fae2fea08f74, apu/bapu/dsp/SPC_DSP.cpp,
+ * initial_regs; SPC_DSP::load copies it into external_regs, which
+ * SPC_DSP::read returns). Real hardware leaves these undefined, but drivers
+ * read some back before writing them: FF6's echo init waits (old EDL & $0F)
+ * timer ticks, so EDL = 0 here stalled its boot by 256 ticks (~4.1 s). */
+static const uint8_t powerOnRegs[0x80] = {
+  0x45,0x8B,0x5A,0x9A,0xE4,0x82,0x1B,0x78,0x00,0x00,0xAA,0x96,0x89,0x0E,0xE0,0x80,
+  0x2A,0x49,0x3D,0xBA,0x14,0xA0,0xAC,0xC5,0x00,0x00,0x51,0xBB,0x9C,0x4E,0x7B,0xFF,
+  0xF4,0xFD,0x57,0x32,0x37,0xD9,0x42,0x22,0x00,0x00,0x5B,0x3C,0x9F,0x1B,0x87,0x9A,
+  0x6F,0x27,0xAF,0x7B,0xE5,0x68,0x0A,0xD9,0x00,0x00,0x9A,0xC5,0x9C,0x4E,0x7B,0xFF,
+  0xEA,0x21,0x78,0x4F,0xDD,0xED,0x24,0x14,0x00,0x00,0x77,0xB1,0xD1,0x36,0xC1,0x67,
+  0x52,0x57,0x46,0x3D,0x59,0xF4,0x87,0xA4,0x00,0x00,0x7E,0x44,0x00,0x4E,0x7B,0xFF,
+  0x75,0xF5,0x06,0x97,0x10,0xC3,0x24,0xBB,0x00,0x00,0x7B,0x7A,0xE0,0x60,0x12,0x0F,
+  0xF7,0x74,0x1C,0xE5,0x39,0x3D,0x73,0xC1,0x00,0x00,0x7A,0xB3,0xFF,0x4E,0x7B,0xFF
+};
+
 static void dsp_cycleChannel(Dsp* dsp, int ch);
 static void dsp_handleEcho(Dsp* dsp, int* outputL, int* outputR, bool audit);
 static void dsp_handleGain(Dsp* dsp, int ch, bool liveGain);
@@ -144,8 +161,16 @@ void dsp_reset(Dsp* dsp) {
     filter->voices = (uint8_t)~voices;
     (void)dsp_set_output_voices(dsp, voices);
   }
-  memset(dsp->ram, 0, sizeof(dsp->ram));
-  dsp->ram[0x7c] = 0xff; // set ENDx
+  // Only the readback mirror takes the power-on values. snes9x synthesizes
+  // from a separate internal register file that powers on cleared with
+  // FLG = $E0, which is what the derived state below already models: no
+  // keyOn latch for KON, echoDelay stays 1 although EDL reads $4E. (Its
+  // internal V4/V5 PITCHL = 1 is not mirrored: snes9x zeroes the
+  // interpolation position on key-on, this core keeps pitchCounter.)
+  memcpy(dsp->ram, powerOnRegs, sizeof(dsp->ram));
+  // ENDx: snes9x's first sample replaces the table's $FF with its internal
+  // ENDX (0), long before the IPL hands over, so the SPC can only see 0.
+  dsp->ram[0x7c] = 0;
   for(int i = 0; i < 8; i++) {
     dsp->channel[i].pitch = 0;
     dsp->channel[i].pitchCounter = 0;
-- 
